# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/atcc-website?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=your-super-secure-random-string-change-this-in-production

# Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ATCC Website" <noreply@atcccanada.ca>

# Application Settings
ADMIN_EMAIL=admin@atcccanada.ca
SITE_URL=https://your-app.railway.app

# Security Settings (set to 'true' only for initial setup, then remove)
ENABLE_SETUP=false